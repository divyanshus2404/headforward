{
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/leantokens.py",
      "destination": "/headforward.py",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
